<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Inputs;assembly=Syncfusion.Maui.Inputs"
             x:Class="CreditCardInput.MainPage">

    <ScrollView>
        <VerticalStackLayout Padding="20" 
                             Spacing="20">
            
            <!-- Header -->
            <VerticalStackLayout Spacing="5">
                <Label Text="Payment Details" 
                       FontSize="24" 
                       FontAttributes="Bold" />
                <Label Text="Enter your card information securely" 
                       FontSize="12" />
            </VerticalStackLayout>
            
            <!-- Card Number Section -->
            <VerticalStackLayout Spacing="8">
                <Label Text="Card Number" 
                       FontSize="14" 
                       FontAttributes="Bold" 
                       VerticalTextAlignment="Center" />
                <syncfusion:SfMaskedEntry x:Name="CardNumberEntry"
                                          Mask="0000 0000 0000 0000"
                                          Placeholder="Enter card number"
                                          PromptChar="_"
                                          FontSize="16"
                                          ValueChanged="CardNumberEntry_ValueChanged" />
                <Label x:Name="CardStatusLabel" 
                       FontSize="11" />
            </VerticalStackLayout>
            
            <!-- Fixed row and reserved status space prevent remeasurement while typing. -->
            <Grid ColumnDefinitions="*,*"
                  ColumnSpacing="15"
                  RowDefinitions="Auto,52,20">
                <Label Grid.Column="0"
                       Text="Expiry Date"
                       FontSize="14"
                       FontAttributes="Bold" />
                <Label Grid.Column="1"
                       Text="CVV"
                       FontSize="14"
                       FontAttributes="Bold" />

                <syncfusion:SfMaskedEntry Grid.Row="1"
                                          Grid.Column="0"
                                          x:Name="ExpiryEntry"
                                          Mask="00/00"
                                          Placeholder="MM/YY"
                                          PromptChar="_"
                                          FontSize="16"
                                          HorizontalOptions="Start"
                                          WidthRequest="58"
                                          ValueChanged="ExpiryEntry_ValueChanged" />
                <syncfusion:SfMaskedEntry Grid.Row="1"
                                          Grid.Column="1"
                                          x:Name="CVVEntry"
                                          Mask="000"
                                          Placeholder="123"
                                          PromptChar="_"
                                          FontSize="16"
                                          HorizontalOptions="Start"
                                          WidthRequest="45"
                                          ValueChanged="CVVEntry_ValueChanged" />

                <Label Grid.Row="2"
                       Grid.Column="0"
                       x:Name="ExpiryStatusLabel"
                       FontSize="11"
                       HeightRequest="20"
                       LineBreakMode="NoWrap" />
                <Label Grid.Row="2"
                       Grid.Column="1"
                       x:Name="CVVStatusLabel"
                       FontSize="11"
                       HeightRequest="20"
                       LineBreakMode="NoWrap" />
            </Grid>
            
            <!-- Cardholder Name -->
            <VerticalStackLayout Spacing="8">
                <Label Text="Cardholder Name" 
                       FontSize="14" 
                       FontAttributes="Bold" />
                <Entry x:Name="CardholderEntry"
                       Placeholder="Full name on card"
                       FontSize="16"
                       TextChanged="OnCardholderChanged" />
                <Label x:Name="NameStatusLabel" 
                       FontSize="11" 
                       TextColor="#666666" />
            </VerticalStackLayout>
            
            <!-- Spacer -->
            <BoxView HeightRequest="1" 
                     Color="#E0E0E0" />
            
            <!-- Submit Button -->
            <Button x:Name="SubmitButton"
                    Text="Process Payment"
                    Padding="12"
                    CornerRadius="8"
                    BorderWidth="0"
                    FontSize="16"
                    FontAttributes="Bold"
                    TextColor="White"
                    BackgroundColor="#007AFF"
                    IsEnabled="False"
                    Opacity="0.6"
                    Clicked="OnSubmitClicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
